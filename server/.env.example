# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of origins allowed to call the API (the Vite dev server,
# and the production site domain).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://drnamanaggarwal.com

# ─── Database ──────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/dr-naman
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dr-naman?retryWrites=true&w=majority
# Put the real credentials in .env (gitignored) — never in this template.
MONGODB_URI=mongodb://127.0.0.1:27017/dr-naman

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=2b68bb89f4c0eee8d178005601b3fbc7c32666a9102aabe9aad95ed22e993048ea132a97c679d0a273ee51117297c636
JWT_REFRESH_SECRET=8f822e63817bddb1687c05e80d7157bdbb62a60a1ca08ad6ee3e1906332991ee019923a18fca4a5a46096e41261d45a1
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Cookie flags. Set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ─── Bootstrap admin (used by `npm run create:admin` and the seeder) ────────
ADMIN_EMAIL=admin@drnamanaggarwal.com
ADMIN_PASSWORD=ChangeMe!2024
ADMIN_NAME=Site Administrator

# ─── Media uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
# Public base used to build absolute media URLs. Leave blank to use the request host.
PUBLIC_URL=

# ─── Email (appointment alerts + CMS password-reset codes) ──────────────────
# Leave SMTP_HOST blank to disable. Appointment alerts then no-op quietly, but
# password reset needs real delivery: with SMTP off it logs the code to the
# server console in development, and refuses outright in production.
#
# Gmail setup (smtp.gmail.com):
#   1. The account must have 2-Step Verification switched on.
#   2. Generate an App Password — https://myaccount.google.com/apppasswords —
#      and put that 16-character value in SMTP_PASS. A normal Gmail password
#      will be rejected; Google turned off "less secure app access" in 2022.
#   3. SMTP_USER must be the full Gmail address.
#   4. MAIL_FROM must be that same address (or a verified "Send mail as" alias)
#      — Gmail silently rewrites, or rejects, a From it does not own. Left
#      blank, the server falls back to SMTP_USER, which is always safe.
#
# Port 587 with SMTP_SECURE=false is STARTTLS and the right default.
# Use port 465 with SMTP_SECURE=true only if 587 is blocked by your host.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where new appointment requests are emailed
NOTIFY_EMAIL=clinic@drnamanaggarwal.com
