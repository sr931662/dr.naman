{
  "name": "dr-naman-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API + CMS for Dr. Naman Aggarwal — Urology practice website",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:client": "npm --prefix ../client ci && npm --prefix ../client run build",
    "serve": "npm run build:client && node src/index.js",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset",
    "create:admin": "node src/scripts/createAdmin.js",
    "test": "node src/scripts/smoke.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.16",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
  }
}
