# ─── Frontend environment variables ─────────────────────────────────────────
#
# IMPORTANT: Vite inlines every VITE_* variable into the JavaScript bundle at
# build time. Anything here is publicly readable by anyone who opens DevTools.
# Never put a database URI, an API key, or a JWT secret in this file.
#
# Copy to .env.local for local development (.env.local is gitignored).
# For production, set these in the Vercel dashboard:
#   Project → Settings → Environment Variables

# Base URL of the backend API, including the /api suffix.
#
#   local        http://localhost:5000/api
#   production   https://your-service.run.app/api
#
# Leave blank to use a relative "/api" — correct when the backend is on the
# same origin (Vite dev proxy, or Express serving the built site).
VITE_API_URL=http://localhost:5000/api

# Where the CMS is hosted. Only needed if you add a staff-login link to the
# site. Defaults to a relative /admin.
VITE_ADMIN_URL=http://localhost:5000/admin
