{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-CLOUD-RUN-URL.run.app/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://YOUR-CLOUD-RUN-URL.run.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://YOUR-CLOUD-RUN-URL.run.app/admin/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://YOUR-CLOUD-RUN-URL.run.app/uploads/:path*"
    },
    {
      "source": "/((?!api/|admin|uploads/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
