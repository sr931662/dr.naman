# Local development defaults. Safe to commit — VITE_* values are public by
# design, and these only point at localhost.
#
# Blank on purpose: the Vite dev server proxies /api and /admin to the backend
# on :5000, so relative paths work and there is no CORS in development.
# Override in .env.local if you need to point at a deployed backend instead.
VITE_API_URL=
VITE_ADMIN_URL=
