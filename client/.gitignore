# Frontend-specific rules. The root .gitignore covers the shared cases —
# these exist so the client folder stays safe if it is ever split out.

# ─── Environment files ──────────────────────────────────────────────────────
# Vite inlines VITE_* variables into the browser bundle, so nothing here is
# ever secret. The shared, non-secret defaults ARE committed; only the personal
# .local overrides are kept out.
.env
.env.*
!.env.example
!.env.development
!.env.production
.env.local
.env.*.local

node_modules/
dist/
dist-ssr/
.vite/

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

*.local
.eslintcache

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
